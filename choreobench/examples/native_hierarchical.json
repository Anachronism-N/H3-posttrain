{
  "mode": "hierarchical",
  "local_provider": {
    "kind": "native",
    "family": "omni_captioner",
    "model": "/models/Qwen3-Omni-30B-A3B-Captioner",
    "checkpoint": "/models/choreography-run/checkpoint-final",
    "training_source_dir": "/models/choreography-run/frozen_training_sources",
    "device": "cuda:0",
    "max_length": 8192,
    "temperature": 0.9,
    "top_p": 0.95,
    "top_k": 50
  },
  "planner_provider": {
    "kind": "chat_completions",
    "base_url": "http://127.0.0.1:8000/v1",
    "model": "REPLACE_WITH_ACTUAL_INSTRUCTION_MODEL",
    "api_key_env": "CHOREOBENCH_API_KEY",
    "timeout_seconds": 180,
    "temperature": 0,
    "json_mode": true,
    "token_parameter": "max_tokens"
  },
  "seed": 7,
  "max_calls": 1500,
  "max_output_tokens": 2048,
  "planner_max_output_tokens": 16384,
  "window_seconds": 5.0625,
  "stride_seconds": 5.0625,
  "candidates_per_window": 1,
  "splits": ["dev"],
  "continue_on_model_error": true
}
