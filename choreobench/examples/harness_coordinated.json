{
  "mode": "coordinated",
  "planner_provider": {
    "kind": "chat_completions",
    "base_url": "http://127.0.0.1:8000/v1",
    "model": "REPLACE_WITH_ACTUAL_INSTRUCTION_MODEL",
    "api_key_env": "CHOREOBENCH_API_KEY",
    "timeout_seconds": 600,
    "temperature": 0,
    "json_mode": true,
    "token_parameter": "max_tokens"
  },
  "splits": [
    "dev"
  ],
  "seed": 7,
  "max_calls": 100,
  "max_output_tokens": 2048,
  "outline_max_output_tokens": 4096,
  "max_request_characters": 120000,
  "unit_config": {
    "bars_per_block": 4,
    "max_unit_seconds": 20,
    "fallback_seconds": 10.125,
    "meter_status": "unverified"
  },
  "continue_on_model_error": true,
  "structured_unit_output": true,
  "max_events_per_unit": 3
}
